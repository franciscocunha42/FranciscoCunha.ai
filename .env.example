# Contact form (Cloudflare Pages Function: functions/api/contact.ts)
# Set these in Cloudflare → your Pages project → Settings → Variables and Secrets.
# For local testing with `npx wrangler pages dev out`, put them in a .dev.vars file.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Campos Cunha Consulting <contact@franciscocunha.ai>"
CONTACT_FROM=
# Optional — defaults to francisco.m.camposcunha@gmail.com
CONTACT_TO=
